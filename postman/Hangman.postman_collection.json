{
  "info": {
    "name": "Hangman Player API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "playerName",
      "value": "Postman Demo Change Me"
    }
  ],
  "item": [
    {
      "name": "1 Missing player",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/players?playerName={{playerName}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "2 Create player",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/players",
        "body": {
          "mode": "raw",
          "raw": "{\"playerName\": \"{{playerName}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const p=pm.response.json(); pm.collectionVariables.set(\"playerID\",p.playerID); pm.collectionVariables.set(\"version\",p.version);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Look up player",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/players?playerName={{playerName}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "4 Record win",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/players/{{playerID}}",
        "body": {
          "mode": "raw",
          "raw": "{\"wins\": 1, \"losses\": 0, \"version\": 0}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "5 Record loss",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/players/{{playerID}}",
        "body": {
          "mode": "raw",
          "raw": "{\"wins\": 1, \"losses\": 1, \"version\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "6 Reject stale result",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/players/{{playerID}}",
        "body": {
          "mode": "raw",
          "raw": "{\"wins\": 1, \"losses\": 0, \"version\": 0}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 409\", () => pm.response.to.have.status(409));",
              ""
            ]
          }
        }
      ]
    }
  ]
}
